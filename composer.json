{
    "name": "solspace/craft-aiassistant",
    "description": "AI-powered text and image generation for Craft CMS with custom prompts and multi-model support.",
    "type": "craft-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Solspace",
            "homepage": "https://solspace.com/"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.0.0",
    "require": {
        "craftcms/cms": "^4.0.0|^5.0.0",
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Solspace\\AIAssistant\\": "src/"
        }
    },
    "extra": {
        "name": "AI Assistant",
        "handle": "ai-assistant",
        "class": "Solspace\\AIAssistant\\AiAssistant",
        "hasCpSettings": true,
        "hasCpSection": true,
        "developer": "Solspace",
        "developerUrl": "https://solspace.com/",
        "documentationUrl": "https://docs.solspace.com/",
        "changelogUrl": "https://docs.solspace.com/changelog/"
    },
    "scripts": {
        "fix": "vendor/bin/php-cs-fixer fix --diff --config=./.php-cs-fixer.dist.php",
        "fix:dry-run": "vendor/bin/php-cs-fixer fix --dry-run --diff --config=./.php-cs-fixer.dist.php"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
