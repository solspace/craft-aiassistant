{
    "name": "solspace/craft-aiassistant",
    "description": "Generate smarter text and images with AI using custom prompts and support for multiple models.",
    "version": "1.0.0",
    "type": "craft-plugin",
    "authors": [
        {
            "name": "Solspace",
            "homepage": "https://solspace.com/"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "craftcms/cms": "^5.0.0",
        "php": "^8.2.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Solspace\\AIAssistant\\": "src/"
        }
    },
    "extra": {
        "schemaVersion": "1.0.0",
        "handle": "ai-assistant",
        "class": "Solspace\\AIAssistant\\AiAssistant",
        "name": "AI Assistant",
        "developer": "Solspace",
        "developerUrl": "https://docs.solspace.com/",
        "documentationUrl": "https://docs.solspace.com/craft/ai-assistant/v1/",
        "changelogUrl": "https://raw.githubusercontent.com/solspace/craft-aiassistant/v1/CHANGELOG.md",
        "hasSettings": true,
        "hasCpSection": true
    },
    "scripts": {
        "fix": "vendor/bin/php-cs-fixer fix --diff --config=./.php-cs-fixer.dist.php",
        "fix:dry-run": "vendor/bin/php-cs-fixer fix --dry-run --diff --config=./.php-cs-fixer.dist.php"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
