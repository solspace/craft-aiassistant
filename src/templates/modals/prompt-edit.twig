{% import "_includes/forms" as forms %}
{% set prompts = prompts ?? [] %}

<div class="modal ai-assistant-prompt-modal">
    <div class="header">
        <h2 id="ai-assistant-prompt-modal-title">
            <span id="aiassistant-prompt-modal-icon"></span>
            <span id="aiassistant-prompt-modal-text">{{ 'Manage Prompts'|t('ai-assistant') }}</span>
        </h2>
    </div>
    
    <div class="body" style="max-height:70vh; overflow-y:auto; padding:20px 20px 80px 20px;">
        <!-- Select Existing Prompt Section -->
        <div id="prompt-select-mode">
            <div style="margin-bottom:20px;">
                <h3 style="margin:0 0 12px 0; font-weight:600;">{{ 'Select Prompt'|t('ai-assistant') }}</h3>
                
                {% set promptOptions = [{ label: 'Any'|t('ai-assistant'), value: '' }] %}
                {% for p in prompts %}
                    {% set promptOptions = promptOptions|merge([{ label: p.name|t('ai-assistant') ~ ' (' ~ (p.type|title|t('ai-assistant')) ~ ')', value: p.id, data: { type: p.type } }]) %}
                {% endfor %}
                {{ forms.selectField({
                    id: 'prompt-existing-select',
                    name: 'prompt-existing-select',
                    options: promptOptions,
                    instructions: 'Choose an existing prompt to use for this field, or leave as "Any" to allow all prompts.'|t('ai-assistant')
                }) }}
            </div>
            
            <!-- Prompt Details Section (shown when prompt is selected) -->
            <div id="prompt-details-section" style="display:none; margin-bottom:24px; padding:16px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:6px;">
                <div style="margin-bottom:12px;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                        <span id="prompt-details-name" style="font-weight:600; font-size:14px;"></span>
                        <span id="prompt-details-type" class="ai-assistant-type-badge" style="font-size:10px;"></span>
                    </div>
                    <div id="prompt-details-integration" style="font-size:12px; color:#6b7280; margin-bottom:8px;"></div>
                </div>
                <div style="margin-top:12px; padding-top:12px; border-top:1px solid #e5e7eb;">
                    <div style="font-size:11px; font-weight:600; color:#374151; margin-bottom:6px;">{{ 'Prompt Text'|t('ai-assistant') }}</div>
                    <div id="prompt-details-text" style="font-size:12px; color:#4b5563; line-height:1.5; white-space:pre-wrap; max-height:120px; overflow-y:auto;"></div>
                </div>
            </div>
            
            <div style="margin-top:24px; padding-top:24px;">
                {{ 'or'|t('ai-assistant') }} <button type="button" id="show-create-prompt-form" class="btn">{{ 'Create New Prompt'|t('ai-assistant') }}</button>
            </div>
        </div>
        
        <!-- Create New Prompt Form Section -->
        <div id="prompt-create-mode" style="display:none;">
            <div style="margin-bottom:20px;">
                <h3 style="margin:0 0 12px 0; font-weight:600;">{{ 'Create New Prompt'|t('ai-assistant') }}</h3>
                <p class="instructions" style="margin:4px 0 16px 0;">{{ 'Create a new custom prompt for AI text generation.'|t('ai-assistant') }}</p>
            </div>
            
            <form method="post" id="prompt-edit-form">
                {{ csrfInput() }}
                {{ actionInput('ai-assistant/api/save-prompt') }}
                
                <div style="margin-bottom:20px;">
                    {{ forms.textField({
                        label: 'Name'|t('app'),
                        id: 'modal-name',
                        name: 'name',
                        required: true,
                        instructions: 'Give your prompt a descriptive name.'|t('ai-assistant')
                    }) }}
                </div>
                
                <div style="margin-bottom:20px;">
                {{ forms.selectField({
                        label: 'Type'|t('ai-assistant'),
                        id: 'modal-type',
                        name: 'type',
                        value: 'generate',
                        options: [
                            { label: 'Generate Text'|t('ai-assistant'), value: 'generate' },
                            { label: 'Rephrase Content'|t('ai-assistant'), value: 'rephrase' },
                            { label: 'Translate Text'|t('ai-assistant'), value: 'translate' },
                            { label: 'Generate Image'|t('ai-assistant'), value: 'image' },
                        ],
                        instructions: 'Select the type of prompt.'|t('ai-assistant')
                    }) }}
                </div>
                
                <div style="margin-bottom:20px;">
                    {{ forms.selectField({
                        label: 'Integration'|t('ai-assistant'),
                        id: 'modal-integration',
                        name: 'integrationHandle',
                        options: [],
                        instructions: 'Select the AI integration to use.'|t('ai-assistant')
                    }) }}
                </div>
                
                <div id="image-extra-options" style="display:none; margin-bottom:16px; padding:5px;">
                    <div style="display:flex; gap:12px;">
                        <div style="flex:1">
                            {{ forms.selectField({
                                label: 'OpenAI Model'|t('ai-assistant'),
                                id: 'modal-image-model',
                                name: 'imageModel',
                                options: [
                                    { label: 'DALL·E 3', value: 'dall-e-3' },
                                    { label: 'DALL·E 2', value: 'dall-e-2' },
                                ],
                                instructions: 'Model used when generating with this prompt (can still be overridden in the generation modal).'|t('ai-assistant')
                            }) }}
                        </div>
                        <div style="flex:1">
                            {{ forms.selectField({
                                label: 'Default Size'|t('ai-assistant'),
                                id: 'modal-image-size',
                                name: 'imageSize',
                                options: [
                                    { label: '256x256', value: '256x256' },
                                    { label: '512x512', value: '512x512' },
                                    { label: '1024x1024', value: '1024x1024' },
                                ],
                            }) }}
                        </div>
                        <div style="flex:1">
                            {{ forms.textField({
                                label: 'Default Count'|t('ai-assistant'),
                                id: 'modal-image-count',
                                name: 'imageCount',
                                value: 1,
                            }) }}
                        </div>
                    </div>
                    <div style="display:flex; gap:12px;">
                        <div style="flex:1">
                            {{ forms.textField({
                                label: 'Preferred Volume ID'|t('ai-assistant'),
                                id: 'modal-image-volume',
                                name: 'imageVolumeId',
                                instructions: 'Optional. If blank, you can select per-generation.'|t('ai-assistant')
                            }) }}
                        </div>
                        <div style="flex:1">
                            {{ forms.textField({
                                label: 'Preferred Folder ID'|t('ai-assistant'),
                                id: 'modal-image-folder',
                                name: 'imageFolderId',
                                instructions: 'Optional. If blank, top-level of volume.'|t('ai-assistant')
                            }) }}
                        </div>
                    </div>
                    <p class="instructions" style="margin-top:8px;">{{ 'These defaults are stored on the prompt and can be used by the generation modal. They do not affect other prompts.'|t('ai-assistant') }}</p>
                </div>

                <div style="margin-bottom:60px;">
                    {{ forms.textareaField({
                        label: 'Prompt Text'|t('ai-assistant'),
                        id: 'modal-promptText',
                        name: 'promptText',
                        rows: 5,
                        required: true,
                        instructions: 'Enter the prompt text that will be sent to the AI. You can use variables and context placeholders.'|t('ai-assistant')
                    }) }}
                </div>
            </form>
            
            <div style="margin-top:24px; padding-top:24px; border-top:1px solid #e5e7eb;">
                <button type="button" id="show-select-prompt" class="btn">{{ 'Select Existing Prompt'|t('ai-assistant') }}</button>
            </div>
        </div>
    </div>

    <div class="footer" style="position:absolute; bottom:0; width:100%; padding:15px 20px; border-top:1px solid #e5e7eb; display:flex; align-items:center; justify-content:flex-end; gap:8px;">
        <button type="button" class="btn cancel" data-close-modal>{{ 'Cancel'|t('app') }}</button>
        <button type="button" id="save-selected-prompt-btn" class="btn submit" style="display:none;">{{ 'Save'|t('app') }}</button>
        <button type="button" id="save-prompt-btn" class="btn submit" style="display:none;">{{ 'Save'|t('app') }}</button>
    </div>
</div>

