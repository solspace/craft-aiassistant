{% import '_includes/forms' as forms %}

<div class="modal aiassistant-modal">
    <div class="header">
        <h2 id="aiassistant-modal-title">
            <span id="aiassistant-modal-icon"></span>
            <span id="aiassistant-modal-text">{{ 'AI Assistant'|t('aiassistant') }}</span>
        </h2>
    </div>
    
    <div class="body">
        <!-- Top row: Prompt and Integration selection -->
        <div class="aiassistant-prompt-select-row">
            <div class="aiassistant-prompt-select-col">
                {{ forms.selectField({
                    id: 'aiassistant-text-prompt',
                    name: 'aiassistant-text-prompt',
                    label: 'Prompt'|t('aiassistant'),
                    options: [{ label: 'Loading…'|t('aiassistant'), value: '' }],
                    instructions: 'Choose a prompt to generate text with.'|t('aiassistant')
                }) }}
            </div>
            <div class="aiassistant-prompt-select-col">
                {{ forms.selectField({
                    id: 'aiassistant-text-integration',
                    name: 'aiassistant-text-integration',
                    label: 'Integration'|t('aiassistant'),
                    options: [{ label: 'Loading…'|t('aiassistant'), value: '' }],
                    instructions: 'Defaulted from the prompt; you can change it.'|t('aiassistant')
                }) }}
            </div>
        </div>

        <!-- Prompt text (left) and Image options (right when type=image) -->
        <div class="aiassistant-prompt-content-row">
            <div id="aiassistant-prompt-left" class="aiassistant-prompt-left">
                {{ forms.textareaField({
                    id: 'aiassistant-text-prompt-text',
                    name: 'aiassistant-text-prompt-text',
                    label: 'Prompt Text'|t('aiassistant'),
                    rows: 2,
                    instructions: 'Edit the prompt text as needed. This is what will be sent to the AI. You can modify it to better suit your needs. Select `Custom...` to write your own prompt from scratch.'|t('aiassistant')
                }) }}
            </div>
            <div id="aiassistant-image-col" class="aiassistant-image-col">
                <div id="aiassistant-image-options">
                    <div class="aiassistant-image-options-row">
                        <div class="size-field-wrap">
                            {{ forms.textField({
                                id: 'aiassistant-image-size',
                                name: 'aiassistant-image-size',
                                label: 'Size'|t('aiassistant'),
                                placeholder: '1024x1024',
                                instructions: 'WidthxHeight, e.g., 1024x1024.'|t('aiassistant')
                            }) }}
                        </div>
                        <div class="count-field">
                            {{ forms.textField({
                                id: 'aiassistant-image-count',
                                name: 'aiassistant-image-count',
                                label: 'Count'|t('aiassistant'),
                                value: 1,
                                instructions: 'Number of images.'|t('aiassistant')
                            }) }}
                        </div>
                        <div class="asset-target-field">
                            {{ forms.selectField({
                                id: 'aiassistant-asset-target',
                                name: 'aiassistant-asset-target',
                                label: 'Asset Target (Volume or Folder)'|t('aiassistant'),
                                instructions: 'Where to save images.'|t('aiassistant'),
                                options: assetTargetOptions ?? [],
                                value: defaultAssetTargetValue ?? '',
                            }) }}
                        </div>
                    </div>
                    <div id="aiassistant-image-preview"></div>
                </div>
            </div>
        </div>

        <!-- Input context and Generated text - side by side (always visible) -->
        <div id="aiassistant-text-comparison">
            <div class="aiassistant-comparison-row">
                <div class="aiassistant-comparison-col">
                    <div class="field aiassistant-input-context-field">
                        <div class="heading">
                            <div class="lightswitch-wrapper">
                                {{ forms.lightswitch({
                                    id: 'aiassistant-include-context',
                                    name: 'aiassistant-include-context',
                                    on: true
                                }) }}
                            </div>
                            <div class="heading-content">
                                <span class="aiassistant-generated-title">{{ 'Input Context'|t('aiassistant') }}</span>
                                <span class="light">{{ 'Current content from the field. Toggle to include it in the generation.'|t('aiassistant') }}</span>
                            </div>
                        </div>
                        <div class="input">
                            <div id="aiassistant-text-input-rich" class="aiassistant-rich-editor" contenteditable="true" role="textbox" aria-multiline="true"></div>
                        </div>
                    </div>
                </div>
                <div class="aiassistant-comparison-col">
                    <div class="field aiassistant-input-context-field">
                        <div class="heading">
                            <span class="aiassistant-generated-title" id="aiassistant-generated-title">{{ 'Generated Text'|t('aiassistant') }}</span>
                        </div>
                        <div class="instructions">
                            <p id="aiassistant-generated-instructions">{{ 'AI-generated content. Click Insert to replace the current content.'|t('aiassistant') }}</p>
                        </div>
                        <div class="input">
                            <div id="aiassistant-text-generated-rich" class="aiassistant-rich-editor" contenteditable="true" role="textbox" aria-multiline="true"></div>
                            <div id="aiassistant-image-preview-right" class="aiassistant-image-slider aiassistant-hidden">
                                <button type="button" class="aiassistant-image-slider-button prev" aria-label="{{ 'Previous image'|t('aiassistant') }}">‹</button>
                                <div class="aiassistant-image-slider-viewport">
                                    <img class="aiassistant-image-slider-img" src="" alt="{{ 'Generated image preview'|t('aiassistant') }}" />
                                </div>
                                <button type="button" class="aiassistant-image-slider-button next" aria-label="{{ 'Next image'|t('aiassistant') }}">›</button>
                                <div class="aiassistant-image-slider-counter aiassistant-hidden">0 / 0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Input context - fallback for plain text (hidden; using comparison layout instead) -->
        <div id="aiassistant-text-input-fallback" class="aiassistant-hidden">
            {{ forms.textareaField({
                id: 'aiassistant-text-input',
                name: 'aiassistant-text-input',
                label: 'Input Context'|t('aiassistant'),
                rows: 3,
                instructions: 'Optional context to include in generation. Will be appended to the prompt.'|t('aiassistant')
            }) }}
        </div>

        <!-- Generated text result - fallback for plain text (hidden; using comparison layout instead) -->
        <div id="aiassistant-text-generated-fallback" class="aiassistant-hidden">
            {{ forms.textareaField({
                id: 'aiassistant-text-generated',
                name: 'aiassistant-text-generated',
                label: 'Generated Text'|t('aiassistant'),
                rows: 6,
                instructions: 'The AI-generated text will appear here.'|t('aiassistant'),
                readonly: true
            }) }}
        </div>
    </div>

    <div class="footer">
        <div id="aiassistant-text-loading" class="spinner aiassistant-hidden"></div>
        <button type="button" class="btn cancel">{{ 'Cancel'|t('app') }}</button>
        <button type="button" class="btn" id="aiassistant-text-generate">{{ 'Generate'|t('aiassistant') }}</button>
        <button type="button" class="btn submit" id="aiassistant-text-insert" disabled>{{ 'Insert'|t('aiassistant') }}</button>
    </div>
</div>



