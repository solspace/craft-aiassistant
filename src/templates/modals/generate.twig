{% import '_includes/forms' as forms %}

<div class="modal aiassistant-modal">
    <div class="header">
        <h2 id="aiassistant-modal-title">
            <span id="aiassistant-modal-icon"></span>
            <span id="aiassistant-modal-text">{{ 'AI Assistant'|t('ai-assistant') }}</span>
        </h2>
    </div>
    
    <div class="body">
        <!-- Two-pane layout: left = all settings/context, right = generated output only -->
        <div id="aiassistant-text-comparison">
            <div class="aiassistant-main-row">
                <div class="aiassistant-left-pane">
                    <!-- Prompt and Integration selection -->
                    <div class="aiassistant-prompt-select-row">
                        <div class="aiassistant-prompt-select-col aiassistant-prompt-select-col--prompt">
                            {{ forms.selectField({
                                id: 'aiassistant-text-prompt',
                                name: 'aiassistant-text-prompt',
                                label: 'Prompt'|t('ai-assistant'),
                                options: [{ label: 'Loading...'|t('ai-assistant'), value: '' }],
                            }) }}
                        </div>
                        <div class="aiassistant-prompt-select-col aiassistant-prompt-select-col--integration">
                            {{ forms.selectField({
                                id: 'aiassistant-text-integration',
                                name: 'aiassistant-text-integration',
                                label: 'Integration'|t('ai-assistant'),
                                options: [{ label: 'Loading...'|t('ai-assistant'), value: '' }],
                            }) }}
                        </div>
                    </div>

                    <!-- Prompt text and options -->
                    <div class="aiassistant-prompt-content-row">
                        <div id="aiassistant-prompt-left" class="aiassistant-prompt-left">
                            {{ forms.textareaField({
                                id: 'aiassistant-text-prompt-text',
                                name: 'aiassistant-text-prompt-text',
                                label: 'Prompt Text'|t('ai-assistant'),
                                rows: 2,
                            }) }}
                        </div>
                        <div id="aiassistant-image-col" class="aiassistant-image-col">
                            <div id="aiassistant-image-options">
                                <div class="aiassistant-image-options-row">
                                    <div class="asset-target-field">
                                        {{ forms.selectField({
                                            id: 'aiassistant-asset-target',
                                            name: 'aiassistant-asset-target',
                                            label: 'Asset Destination'|t('ai-assistant'),
                                            options: assetTargetOptions ?? [],
                                            value: defaultAssetTargetValue ?? '',
                                        }) }}
                                    </div>
                                    <div class="size-field-wrap">
                                        {{ forms.textField({
                                            id: 'aiassistant-image-size',
                                            name: 'aiassistant-image-size',
                                            label: 'Image Size'|t('ai-assistant'),
                                            placeholder: 'e.g. 1024x1024',
                                        }) }}
                                    </div>
                                    <div class="count-field">
                                        {{ forms.textField({
                                            id: 'aiassistant-image-count',
                                            name: 'aiassistant-image-count',
                                            label: 'Number of Images'|t('ai-assistant'),
                                            value: 1,
                                        }) }}
                                    </div>
                                </div>
                                <div id="aiassistant-image-preview"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Input context (left pane only) -->
                    <div class="field aiassistant-input-context-field">
                        <div class="heading">
                            <div class="lightswitch-wrapper">
                                {{ forms.lightswitch({
                                    id: 'aiassistant-include-context',
                                    name: 'aiassistant-include-context',
                                    on: true
                                }) }}
                            </div>
                            <div class="heading-content">
                                <span class="aiassistant-generated-title">{{ 'Include current field content as context'|t('ai-assistant') }}</span>
                            </div>
                        </div>
                        <div class="input">
                            <div id="aiassistant-text-input-rich" class="aiassistant-rich-editor" contenteditable="true" role="textbox" aria-multiline="true"></div>
                        </div>
                    </div>
                </div>

                <!-- Generated output (right pane only) -->
                <div class="aiassistant-right-pane">
                    <div class="field aiassistant-input-context-field">
                        <div class="heading">
                            <span class="aiassistant-generated-title" id="aiassistant-generated-title">{{ 'Generated Text'|t('ai-assistant') }}</span>
                        </div>
                        <div class="instructions">
                            <p id="aiassistant-generated-instructions">{{ 'Review the AI-generated content below. Click Insert to apply it.'|t('ai-assistant') }}</p>
                        </div>
                        <div class="input">
                            <div id="aiassistant-text-generated-rich" class="aiassistant-rich-editor" contenteditable="true" role="textbox" aria-multiline="true"></div>
                            <div id="aiassistant-image-preview-right" class="aiassistant-image-slider aiassistant-hidden">
                                <button type="button" class="aiassistant-image-slider-button prev" aria-label="{{ 'Previous image'|t('ai-assistant') }}">
                                    <span data-icon="leftangle"></span>
                                </button>
                                <div class="aiassistant-image-slider-viewport">
                                    <img class="aiassistant-image-slider-img" src="" alt="{{ 'Generated image preview'|t('ai-assistant') }}" />
                                </div>
                                <button type="button" class="aiassistant-image-slider-button next" aria-label="{{ 'Next image'|t('ai-assistant') }}">
                                    <span data-icon="rightangle"></span>
                                </button>
                                <div class="aiassistant-image-slider-counter aiassistant-hidden">0 / 0</div>
                            </div>
                            <!-- Skeleton Loader -->
                            <div id="aiassistant-skeleton-loader" class="aiassistant-skeleton-loader aiassistant-hidden">
                                <div class="aiassistant-skeleton-content">
                                    <div class="aiassistant-skeleton-line aiassistant-skeleton-line-full"></div>
                                    <div class="aiassistant-skeleton-line aiassistant-skeleton-line-full"></div>
                                    <div class="aiassistant-skeleton-line aiassistant-skeleton-line-90"></div>
                                    <div class="aiassistant-skeleton-line aiassistant-skeleton-line-full"></div>
                                    <div class="aiassistant-skeleton-line aiassistant-skeleton-line-75"></div>
                                    <div class="aiassistant-skeleton-line aiassistant-skeleton-line-full"></div>
                                </div>
                            </div>
                            <!-- Image Skeleton Loader -->
                            <div id="aiassistant-image-skeleton-loader" class="aiassistant-image-skeleton-loader aiassistant-hidden">
                                <div class="aiassistant-image-skeleton-placeholder">
                                    <svg class="aiassistant-image-skeleton-icon" width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M8 10C9.10457 10 10 9.10457 10 8C10 6.89543 9.10457 6 8 6C6.89543 6 6 6.89543 6 8C6 9.10457 6.89543 10 8 10Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        <path d="M21 15L16 10L8 18L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                    <div class="aiassistant-image-skeleton-text">Generating image...</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Input context - fallback for plain text (hidden; using comparison layout instead) -->
        <div id="aiassistant-text-input-fallback" class="aiassistant-hidden">
            {{ forms.textareaField({
                id: 'aiassistant-text-input',
                name: 'aiassistant-text-input',
                label: 'Input Context'|t('ai-assistant'),
                rows: 3,
                instructions: 'Optional context to include in generation. Will be appended to the prompt.'|t('ai-assistant')
            }) }}
        </div>

        <!-- Generated text result - fallback for plain text (hidden; using comparison layout instead) -->
        <div id="aiassistant-text-generated-fallback" class="aiassistant-hidden">
            {{ forms.textareaField({
                id: 'aiassistant-text-generated',
                name: 'aiassistant-text-generated',
                label: 'Generated Text'|t('ai-assistant'),
                rows: 6,
                instructions: 'The AI-generated text will appear here.'|t('ai-assistant'),
                readonly: true
            }) }}
        </div>
    </div>

    <div class="footer">
        <div id="aiassistant-text-loading" class="spinner aiassistant-hidden"></div>
        <button type="button" class="btn cancel">{{ 'Cancel'|t('app') }}</button>
        <button type="button" class="btn" id="aiassistant-text-generate">{{ 'Generate'|t('ai-assistant') }}</button>
        <button type="button" class="btn submit" id="aiassistant-text-insert" disabled>{{ 'Insert'|t('ai-assistant') }}</button>
    </div>
</div>



