{% import '_includes/forms' as forms %}

<div class="modal aiassistant-modal">
    <div class="header">
        <h2 id="aiassistant-modal-title" style="margin:0; display:flex; align-items:center; gap:8px;">
            <span id="aiassistant-modal-icon" style="display:inline-flex; align-items:center; justify-content:center; width:20px; height:20px;"></span>
            <span id="aiassistant-modal-text">{{ 'AI Assistant'|t('aiassistant') }}</span>
        </h2>
    </div>
    
    <div class="body" style="max-height:60vh; overflow-y:auto; padding:20px 20px 60px 20px;">
        <!-- Top row: Prompt and Integration selection -->
        <div style="display:flex; gap:20px; margin-bottom:20px;">
            <div style="flex:1;">
                {{ forms.selectField({
                    id: 'aiassistant-text-prompt',
                    name: 'aiassistant-text-prompt',
                    label: 'Prompt'|t('aiassistant'),
                    options: [{ label: 'Loading…'|t('aiassistant'), value: '' }],
                    instructions: 'Choose a prompt to generate text with.'|t('aiassistant')
                }) }}
            </div>
            <div style="flex:1;">
                {{ forms.selectField({
                    id: 'aiassistant-text-integration',
                    name: 'aiassistant-text-integration',
                    label: 'Integration'|t('aiassistant'),
                    options: [{ label: 'Loading…'|t('aiassistant'), value: '' }],
                    instructions: 'Defaulted from the prompt; you can change it.'|t('aiassistant')
                }) }}
            </div>
        </div>

        <!-- Prompt text (left) and Image options (right when type=image) -->
        <div style="display:flex; gap:20px; margin-bottom:20px;">
            <div id="aiassistant-prompt-left" style="flex:1;">
                {{ forms.textareaField({
                    id: 'aiassistant-text-prompt-text',
                    name: 'aiassistant-text-prompt-text',
                    label: 'Prompt Text'|t('aiassistant'),
                    rows: 2,
                    instructions: 'Edit the prompt text as needed. This is what will be sent to the AI. You can modify it to better suit your needs. Select `Custom...` to write your own prompt from scratch.'|t('aiassistant')
                }) }}
            </div>
            <div id="aiassistant-image-col" style="flex:1;">
                <div id="aiassistant-image-options" style="display:none; padding:15px; border:1px solid #ffecb5; border-radius:6px;">
                    <div style="display:flex; gap:12px;">
                        <div style="flex:1">
                            {{ forms.textField({
                                id: 'aiassistant-image-size',
                                name: 'aiassistant-image-size',
                                label: 'Size'|t('aiassistant'),
                                placeholder: '1024x1024',
                                instructions: 'WidthxHeight, e.g., 1024x1024.'|t('aiassistant')
                            }) }}
                        </div>
                        <div style="width:150px">
                            {{ forms.textField({
                                id: 'aiassistant-image-count',
                                name: 'aiassistant-image-count',
                                label: 'Count'|t('aiassistant'),
                                value: 1,
                                instructions: 'Number of images.'|t('aiassistant')
                            }) }}
                        </div>
                        <div style="flex:1">
                            {{ forms.selectField({
                                id: 'aiassistant-asset-target',
                                name: 'aiassistant-asset-target',
                                label: 'Asset Target (Volume or Folder)'|t('aiassistant'),
                                instructions: 'Where to save images.'|t('aiassistant'),
                                options: assetTargetOptions ?? [],
                                value: defaultAssetTargetValue ?? '',
                            }) }}
                        </div>
                    </div>
                    <div id="aiassistant-image-preview" style="display:flex; gap:10px; flex-wrap:wrap; margin-top:8px;"></div>
                </div>
            </div>
        </div>

        <!-- Input context and Generated text - side by side (always visible) -->
        <div id="aiassistant-text-comparison" style="display:block;">
            <div style="display:flex; gap:20px;">
                <div style="flex:1;">
                    <div class="field" style="margin-bottom:16px;">
                        <div class="heading" style="display:flex; align-items:center; gap:12px;">
                            <div style="display:flex; align-items:center; justify-content:center; width:36px; min-width:36px;">
                                {{ forms.lightswitch({
                                    id: 'aiassistant-include-context',
                                    name: 'aiassistant-include-context',
                                    on: true
                                }) }}
                            </div>
                            <div style="display:flex; flex-direction:column; gap:6px;">
                                <span style="font-weight:600;">{{ 'Input Context'|t('aiassistant') }}</span>
                                <span class="light" style="font-size:12px;">{{ 'Current content from the field. Toggle to include it in the generation.'|t('aiassistant') }}</span>
                            </div>
                        </div>
                        <div class="input">
                            <div id="aiassistant-text-input-rich" class="aiassistant-rich-editor" contenteditable="true" role="textbox" aria-multiline="true" style="min-height:200px; border:1px solid #e5e7eb; border-radius:4px; padding:10px;"></div>
                        </div>
                    </div>
                </div>
                <div style="flex:1;">
                    <div class="field" style="margin-bottom:16px;">
                        <div class="heading">
                            <span style="font-weight:600;" id="aiassistant-generated-title">{{ 'Generated Text'|t('aiassistant') }}</span>
                        </div>
                        <div class="instructions">
                            <p id="aiassistant-generated-instructions">{{ 'AI-generated content. Click Insert to replace the current content.'|t('aiassistant') }}</p>
                        </div>
                        <div class="input">
                            <div id="aiassistant-text-generated-rich" class="aiassistant-rich-editor" contenteditable="true" role="textbox" aria-multiline="true" style="min-height:200px; border:1px solid #e5e7eb; border-radius:4px; padding:10px;"></div>
                            <div id="aiassistant-image-preview-right" style="display:none; gap:10px; flex-wrap:wrap;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Input context - fallback for plain text (hidden; using comparison layout instead) -->
        <div id="aiassistant-text-input-fallback" style="display:none;">
            {{ forms.textareaField({
                id: 'aiassistant-text-input',
                name: 'aiassistant-text-input',
                label: 'Input Context'|t('aiassistant'),
                rows: 3,
                instructions: 'Optional context to include in generation. Will be appended to the prompt.'|t('aiassistant')
            }) }}
        </div>

        <!-- Generated text result - fallback for plain text (hidden; using comparison layout instead) -->
        <div id="aiassistant-text-generated-fallback" style="display:none;">
            {{ forms.textareaField({
                id: 'aiassistant-text-generated',
                name: 'aiassistant-text-generated',
                label: 'Generated Text'|t('aiassistant'),
                rows: 6,
                instructions: 'The AI-generated text will appear here.'|t('aiassistant'),
                readonly: true
            }) }}
        </div>
    </div>

    <div class="footer" style="position:absolute; bottom:0; width:100%; padding:15px 20px; border-top:1px solid #e5e7eb; display:flex; align-items:center; justify-content:flex-end; gap:8px;">
        <div id="aiassistant-text-loading" class="spinner" style="display:none;"></div>
        <button type="button" class="btn cancel">{{ 'Cancel'|t('app') }}</button>
        <button type="button" class="btn" id="aiassistant-text-generate">{{ 'Generate'|t('aiassistant') }}</button>
        <button type="button" class="btn submit" id="aiassistant-text-insert" disabled>{{ 'Insert'|t('aiassistant') }}</button>
    </div>
</div>



