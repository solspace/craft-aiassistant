{% extends '_layouts/cp' %}
{% set title = 'AI Assistant'|t('ai-assistant') %}

{% block content %}
  <div class="pane" style="padding: 18px;">
    <h2 style="margin-top:0;">{{ "Welcome to AI Assistant"|t('ai-assistant') }}</h2>
    <p style="color: var(--gray-600); max-width: 60ch;">
      {{ "Generate, rephrase, translate text, and generate images directly inside Craft. Define your own prompts and connect to your preferred AI providers."|t('ai-assistant') }}
    </p>

    <div style="display:flex; flex-wrap:wrap; gap:12px; margin:16px 0 6px;">
      <a class="btn submit" href="{{ url('ai-assistant/prompts') }}">{{ "Manage Prompts"|t('ai-assistant') }}</a>
      <a class="btn" href="{{ url('ai-assistant/integrations') }}">{{ "Integrations"|t('ai-assistant') }}</a>
      <a class="btn" href="{{ url('ai-assistant/settings') }}">{{ "Settings"|t('ai-assistant') }}</a>
    </div>
  </div>
{% endblock %}


