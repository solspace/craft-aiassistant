{% extends "_layouts/cp" %}

{% import "_includes/forms" as forms %}

{# Ensure integration variable exists to avoid runtime errors #}
{% set integration = integration is defined ? integration : {
    id: null,
    enabled: true,
    name: '',
    handle: '',
    type: 'openai',
    apiKey: '',
    model: '',
    maxTokens: 2000,
    temperature: 1.0
} %}

{% set title = integration.id ? "Edit Integration"|t('aiassistant') : "New Integration"|t('aiassistant') %}
{% set selectedSubnavItem = 'integrations' %}
{% set crumbs = [
  { label: 'AI Assistant'|t('aiassistant'), url: url('ai-assistant') },
  { label: 'Integrations'|t('aiassistant'), url: url('ai-assistant/integrations') },
  { label: (integration.id ? 'Edit' : 'New'), url: url('ai-assistant/integrations' ~ (integration.id ? '/' ~ integration.id : '/edit')) },
] %}

{% block actionButton %}
    <button type="button" class="btn submit" onclick="document.getElementById('integration-form').submit()">{{ "Save"|t('app') }}</button>
{% endblock %}

{% block content %}
    <form method="post" accept-charset="UTF-8" id="integration-form">
        {{ csrfInput() }}
        {{ actionInput('ai-assistant/integrations/save') }}
        {{ hiddenInput('id', integration.id) }}

        <div class="field">
            {{ forms.lightswitchField({
                label: "Enabled"|t('app'),
                instructions: "Enable or disable this integration."|t('aiassistant'),
                id: 'enabled',
                name: 'enabled',
                on: integration.enabled,
            }) }}
        </div>

        <div class="field">
            {{ forms.textField({
                label: "Name"|t('app'),
                instructions: "A friendly name for this integration."|t('aiassistant'),
                id: 'name',
                name: 'name',
                value: integration.name,
                required: true,
            }) }}
        </div>

        {# Handle will be auto-generated from Name #}
        <div class="field">
            {{ forms.textField({
                label: "Handle"|t('app'),
                instructions: "Auto-generated from Name. Use letters and numbers only."|t('aiassistant'),
                id: 'handle',
                name: 'handle',
                value: integration.handle,
                required: true,
            }) }}
        </div>

        <div class="field">
            {{ forms.selectField({
                label: "Type"|t('app'),
                instructions: "Choose the AI provider for this integration."|t('aiassistant'),
                id: 'type',
                name: 'type',
                value: integration.type,
                options: [
                    { label: 'OpenAI', value: 'openai' },
                    { label: 'Google Gemini', value: 'gemini' },
                    { label: 'Anthropic Claude', value: 'anthropic' },
                    { label: 'xAI Grok', value: 'xai' },
                    { label: 'Replicate', value: 'replicate' },
                ],
                required: true,
            }) }}
        </div>

        <div class="field">
            {{ forms.autosuggestField({
                label: "API Key"|t('aiassistant'),
                instructions: "Enter your API key for this AI provider. You can also reference an environment variable, e.g. `{env:MY_API_TOKEN}`."|t('aiassistant'),
                id: 'apiKey',
                name: 'apiKey',
                value: integration.apiKey,
                required: true,
                suggestEnvVars: true,
                suggestAliases: false,
                class: 'text fullwidth',
            }) }}
        </div>

        <div class="field">
            {{ forms.autosuggestField({
                label: "Model"|t('aiassistant'),
                instructions: "Enter the model identifier to use. A sensible default will be set when you change Type. You can also reference an environment variable, e.g. `{env:MY_MODEL}`."|t('aiassistant'),
                id: 'model',
                name: 'model',
                value: integration.model ?: (integration.type == 'openai' ? 'gpt-5-nano' : (integration.type == 'gemini' ? 'gemini-1.5-flash' : (integration.type == 'anthropic' ? 'claude-3-5-haiku-latest' : (integration.type == 'xai' ? 'grok-3-mini' : '')))),
                required: true,
                placeholder: 'e.g., gpt-5-nano',
                suggestEnvVars: true,
                suggestAliases: false,
                class: 'text fullwidth',
            }) }}
        </div>

        <div class="field">
            {{ forms.textField({
                label: "Max Tokens"|t('aiassistant'),
                instructions: "For supported models, this limits response length. Leave blank or `0` to use provider default. Some models (e.g., reasoning models) ignore Max Tokens."|t('aiassistant'),
                id: 'maxTokens',
                name: 'maxTokens',
                value: integration.maxTokens,
                type: 'number',
                min: 0,
                max: 1048576,
                required: false,
                placeholder: '0 = provider default'
            }) }}
        </div>

        <div class="field" id="temperature-field" style="display: none;">
            {{ forms.textField({
                label: "Temperature"|t('aiassistant'),
                instructions: "Controls randomness (`0.0` = deterministic, `2.0` = very random)."|t('aiassistant'),
                id: 'temperature',
                name: 'temperature',
                value: integration.temperature,
                type: 'number',
                min: 0.0,
                max: 2.0,
                step: 0.1,
            }) }}
        </div>
    </form>

    <script>
        // Set default model and configure fields when type changes
        document.getElementById('type').addEventListener('change', function() {
            updateFieldsForProvider();
        });

        function updateFieldsForProvider() {
            const type = document.getElementById('type').value;
            const modelInput = document.getElementById('model');
            const maxTokensInput = document.getElementById('maxTokens');
            const temperatureField = document.getElementById('temperature-field');
            const temperatureInput = document.getElementById('temperature');

            // Default models for each provider
            const defaults = {
                openai: 'gpt-5-nano',
                gemini: 'gemini-1.5-flash',
                anthropic: 'claude-3-5-haiku-latest',
                xai: 'grok-3-mini',
                replicate: 'black-forest-labs/flux-1.1-pro',
            };

            // Max tokens limits for each provider
            const maxTokensLimits = {
                openai: 128000,
                gemini: 1048576,
                anthropic: 200000,
                xai: 256000,
                replicate: 256000,
            };

            // Providers that support temperature
            const temperatureSupported = ['gemini'];

            // Update model
            const current = (modelInput.value || '').trim();
            if (!current || Object.values(defaults).includes(current)) {
                modelInput.value = defaults[type] || '';
            }

            // Update max tokens limit
            maxTokensInput.max = maxTokensLimits[type] || 1000000;

            // Show/hide temperature field
            if (temperatureSupported.includes(type)) {
                temperatureField.style.display = 'block';
                temperatureInput.required = true;
                if (!temperatureInput.value) {
                    temperatureInput.value = '0.7';
                }
            } else {
                temperatureField.style.display = 'none';
                temperatureInput.required = false;
                temperatureInput.value = '';
            }
        }

        // Initialize fields on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateFieldsForProvider();
            initAutoHandle();
        });

        // --- Auto-generate Handle from Name (camelCase, safe) ---
        function initAutoHandle() {
            const nameInput = document.getElementById('name');
            const handleInput = document.getElementById('handle');
            if (!nameInput || !handleInput) return;

            // If handle is empty on load, mark as auto-generated
            if (!handleInput.value) {
                handleInput.dataset.autogenerated = '1';
                handleInput.value = generateHandleFromName(nameInput.value || '');
            }

            nameInput.addEventListener('input', function() {
                if (!handleInput.value || handleInput.dataset.autogenerated === '1') {
                    handleInput.value = generateHandleFromName(nameInput.value || '');
                    handleInput.dataset.autogenerated = '1';
                }
            });

            // If the user edits the handle manually, stop auto-updating
            handleInput.addEventListener('input', function() {
                handleInput.dataset.autogenerated = '0';
            });
        }

        function generateHandleFromName(name) {
            // Normalize whitespace and separators
            const parts = (name || '')
                .normalize('NFKD')
                .replace(/[\u0300-\u036f]/g, '') // strip diacritics
                .replace(/[^A-Za-z0-9]+/g, ' ') // non-alnum to space
                .trim()
                .split(/\s+/);
            if (parts.length === 0) return '';
            const first = parts[0].toLowerCase();
            const rest = parts.slice(1).map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase());
            let handle = [first, ...rest].join('');
            // Ensure starts with a letter; strip non-letters from start
            handle = handle.replace(/^[^a-zA-Z]+/, '');
            if (!handle) return '';
            // Remove any leftover invalid chars just in case
            handle = handle.replace(/[^a-zA-Z0-9]/g, '');
            // Trim to a reasonable length
            if (handle.length > 64) handle = handle.slice(0, 64);
            return handle;
        }
    </script>
{% endblock %}
