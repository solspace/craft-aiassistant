{% extends "_layouts/cp" %}

{% import "_includes/forms" as forms %}

{% set title = "AI Integrations" %}
{% set selectedSubnavItem = 'integrations' %}
{% set crumbs = [
  { label: 'AI Assistant', url: url('ai-assistant') },
  { label: 'Integrations', url: url('ai-assistant/integrations') },
] %}

{% block actionButton %}
    <a href="{{ url('ai-assistant/integrations/edit') }}" class="btn submit">
        <span data-icon="plus"></span>
        {{ "New Integration"|t('aiassistant') }}
    </a>
{% endblock %}

{% block content %}
    <div class="tableview">
        {% if integrations|length %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ "Name"|t('app') }}</th>
                        <th>{{ "Type"|t('aiassistant') }}</th>
                        <th>{{ "Model"|t('aiassistant') }}</th>
                        <th>{{ "Test Connection"|t('aiassistant') }}</th>
                        <th>{{ "Actions"|t('aiassistant') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for integration in integrations %}
                        <tr>
                            <td>
                                <a href="{{ url('ai-assistant/integrations/' ~ integration.id) }}">
                                    {{ integration.name }}
                                </a>
                            </td>
                            <td>{{ integration.type|title }}</td>
                            <td>{{ integration.model }}</td>
                            <td>
                                <button type="button" class="btn small ai-assistant-test-button" onclick="testIntegration({{ integration.id }}, event)">
                                    Test
                                </button>
                            </td>
                            <td>
                                <div class="ai-assistant-actions">
                                    <a href="{{ url('ai-assistant/integrations/' ~ integration.id) }}" class="btn small" title="Edit">
                                        <span data-icon="edit"></span>
                                    </a>
                                    <form method="post">
                                        {{ csrfInput() }}
                                        {{ actionInput('ai-assistant/integrations/delete') }}
                                        {{ hiddenInput('id', integration.id) }}
                                        <button type="submit" class="btn small" onclick="return confirm('{{ 'Are you sure you want to delete this integration?'|t('aiassistant') }}')" title="Delete">
                                            <span data-icon="trash"></span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="empty-state">
                <h2>{{ "No integrations yet"|t('aiassistant') }}</h2>
                <p>{{ "Get started by adding your first AI integration."|t('aiassistant') }}</p>
                <a href="{{ url('ai-assistant/integrations/edit') }}" class="btn submit">
                    {{ "Add Integration"|t('aiassistant') }}
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}
