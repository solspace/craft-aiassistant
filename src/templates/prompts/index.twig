{% extends "_layouts/cp" %}

{% import "_includes/forms" as forms %}

{% set title = "AI Assistant Prompts"|t('ai-assistant') %}
{% set selectedSubnavItem = 'prompts' %}
{% set crumbs = [
  { label: 'AI Assistant'|t('ai-assistant'), url: url('ai-assistant') },
  { label: 'Prompts'|t('ai-assistant'), url: url('ai-assistant/prompts') },
] %}

{% block actionButton %}
    <div class="btngroup">
        {% if not hasSolspaceAi %}
            <a class="btn" href="{{ url('ai-assistant/integrations/edit', { type: 'solspaceai' }) }}">
                <span data-icon="sparkles"></span>
                {{ "Enable Solspace AI"|t('ai-assistant') }}
            </a>
        {% endif %}
        <a class="btn submit" href="{{ url('ai-assistant/prompts/edit') }}">
            <span data-icon="plus"></span>
            {{ "Add Prompt"|t('ai-assistant') }}
        </a>
    </div>
{% endblock %}

{% block content %}
<div class="ai-assistant-prompts">

    <div class="ai-assistant-prompts-list">
        {% if prompts|length > 0 %}
            <table class="data fullwidth ai-prompts-table">
                <thead>
                    <tr>
                        <th>{{ "Name"|t('ai-assistant') }}</th>
                        <th>{{ "Type"|t('ai-assistant') }}</th>
                        <th>{{ "Integration"|t('ai-assistant') }}</th>
                        <th>{{ "Actions"|t('ai-assistant') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for prompt in prompts %}
                        <tr class="{% if prompt.isBuiltIn %}ai-assistant-builtin-prompt{% endif %}">
                            <td>
                                <strong>{{ prompt.name }}</strong>
                                {% if prompt.isBuiltIn %}
                                    <span class="ai-assistant-builtin-badge">{{ "Built-in"|t('ai-assistant') }}</span>
                                {% endif %}
                                <div class="ai-assistant-prompt-text">{{ prompt.promptText|length > 80 ? prompt.promptText|slice(0, 80) ~ '…' : prompt.promptText }}</div>
                            </td>
                            <td>
                                <span class="ai-assistant-type-badge ai-assistant-type-{{ prompt.type }}">{{ prompt.type|title }}</span>
                            </td>
                            <td>
                                {% if prompt.isBuiltIn %}
                                    {{ "Any"|t('ai-assistant') }}
                                {% else %}
                                    {{ prompt.integrationHandle ?: ("Default"|t('ai-assistant')) }}
                                {% endif %}
                            </td>
                            <td>
                                <div class="ai-assistant-actions">
                                    <a class="btn small" href="{{ url('ai-assistant/prompts/edit', { id: prompt.id }) }}" title="{{ "Edit"|t('ai-assistant') }}">
                                        <span data-icon="edit"></span>
                                    </a>
                                    {% if not prompt.isBuiltIn %}
                                        <form method="post" style="display:inline;">
                                            {{ csrfInput() }}
                                            {{ actionInput('ai-assistant/prompts/delete') }}
                                            {{ hiddenInput('id', prompt.id) }}
                                            <button type="submit" class="btn small delete" onclick="return confirm('{{ "Are you sure you want to delete this prompt?"|t('ai-assistant') }}')" title="{{ "Delete"|t('ai-assistant') }}">
                                                <span data-icon="trash"></span>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="ai-assistant-empty-state">
                <h3>{{ "No custom prompts yet"|t('ai-assistant') }}</h3>
                <p>{{ "Create your first custom prompt to get started with AI Assistant."|t('ai-assistant') }}</p>
                <a class="btn submit" href="{{ url('ai-assistant/prompts/edit') }}">{{ "Add Your First Prompt"|t('ai-assistant') }}</a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

