{% extends "_layouts/cp" %}

{% import "_includes/forms" as forms %}

{% set title = "AI Assistant Prompts" %}
{% set selectedSubnavItem = 'prompts' %}
{% set crumbs = [
  { label: 'AI Assistant', url: url('ai-assistant') },
  { label: 'Prompts', url: url('ai-assistant/prompts') },
] %}

{% block actionButton %}
    <div class="btngroup">
        <a class="btn submit" href="{{ url('ai-assistant/prompts/edit') }}">
            <span data-icon="plus"></span>
            Add Prompt
        </a>
    </div>
{% endblock %}

{% block content %}
<div class="ai-assistant-prompts">

    <div class="ai-assistant-prompts-list">
        {% if prompts|length > 0 %}
            <table class="data fullwidth ai-prompts-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Integration</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for prompt in prompts %}
                        <tr class="{% if prompt.isBuiltIn %}ai-assistant-builtin-prompt{% endif %}">
                            <td>
                                <strong>{{ prompt.name }}</strong>
                                {% if prompt.isBuiltIn %}
                                    <span class="ai-assistant-builtin-badge">Built-in</span>
                                {% endif %}
                                <div class="ai-assistant-prompt-text">{{ prompt.promptText|length > 80 ? prompt.promptText|slice(0, 80) ~ '…' : prompt.promptText }}</div>
                            </td>
                            <td>
                                <span class="ai-assistant-type-badge ai-assistant-type-{{ prompt.type }}">{{ prompt.type|title }}</span>
                            </td>
                            <td>
                                {% if prompt.isBuiltIn %}
                                    Any
                                {% else %}
                                    {{ prompt.integrationHandle ?: 'Default' }}
                                {% endif %}
                            </td>
                            <td>
                                <div class="ai-assistant-actions">
                                    <a class="btn small" href="{{ url('ai-assistant/prompts/edit', { id: prompt.id }) }}" title="Edit">
                                        <span data-icon="edit"></span>
                                    </a>
                                    {% if not prompt.isBuiltIn %}
                                        <form method="post" style="display:inline;">
                                            {{ csrfInput() }}
                                            {{ actionInput('ai-assistant/prompts/delete') }}
                                            {{ hiddenInput('id', prompt.id) }}
                                            <button type="submit" class="btn small delete" onclick="return confirm('Are you sure you want to delete this prompt?')" title="Delete">
                                                <span data-icon="trash"></span>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="ai-assistant-empty-state">
                <h3>No custom prompts yet</h3>
                <p>Create your first custom prompt to get started with AI Assistant.</p>
                <a class="btn submit" href="{{ url('ai-assistant/prompts/edit') }}">Add Your First Prompt</a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

