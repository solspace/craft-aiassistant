{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set prompt = prompt ?? { id: null, name: '', promptText: '', type: 'generate', integrationHandle: null, isActive: true, sortOrder: 0, isBuiltIn: false } %}
{% set integrations = integrations ?? [] %}
{% set title = prompt.id ? ("Edit Prompt"|t('ai-assistant')) : ("New Prompt"|t('ai-assistant')) %}
{% set selectedSubnavItem = 'prompts' %}
{% set crumbs = [
  { label: 'AI Assistant'|t('ai-assistant'), url: url('ai-assistant') },
  { label: 'Prompts'|t('ai-assistant'), url: url('ai-assistant/prompts') },
  { label: (prompt.id ? ("Edit"|t('ai-assistant')) : ("New"|t('ai-assistant'))), url: url('ai-assistant/prompts' ~ (prompt.id ? '/' ~ prompt.id : '/edit')) },
] %}

{% block actionButton %}
  <div class="btngroup">
    <a class="btn" href="{{ url('ai-assistant/prompts') }}">{{ "Back"|t('ai-assistant') }}</a>
    <button type="button" class="btn submit" onclick="document.getElementById('prompt-form').submit()">{{ "Save"|t('ai-assistant') }}</button>
  </div>
{% endblock %}

{% block content %}
  <form method="post" id="prompt-form" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('ai-assistant/prompts/save') }}
    {{ hiddenInput('id', prompt.id) }}

    {# Build integration options for the select field #}
    {% set integrationOptions = [{ label: ("Use default (Any)"|t('ai-assistant')), value: '' }] %}
    {% for i in integrations %}
      {% set integrationOptions = integrationOptions|merge([{ label: i.name ~ ' (' ~ i.handle ~ ')', value: i.handle }]) %}
    {% endfor %}

    <div class="field">
      {{ forms.selectField({
        label: "Integration"|t('ai-assistant'),
        instructions: "Choose which Integration to use for this prompt."|t('ai-assistant'),
        id: 'integrationHandle',
        name: 'integrationHandle',
        value: prompt.integrationHandle ?? '',
        options: integrationOptions,
        required: false,
      }) }}
    </div>

    <div class="field">
      {{ forms.textField({
        label: "Prompt Name"|t('ai-assistant'),
        instructions: "Give your prompt a descriptive name."|t('ai-assistant'),
        id: 'name',
        name: 'name',
        value: prompt.name,
        required: true,
      }) }}
    </div>

    <div class="field">
      {{ forms.selectField({
        label: "Type"|t('ai-assistant'),
        instructions: "Select the type of prompt."|t('ai-assistant'),
        id: 'type',
        name: 'type',
        value: prompt.type,
        required: true,
        options: [
          { label: ("Generate Text"|t('ai-assistant')), value: 'generate' },
          { label: ("Rephrase Content"|t('ai-assistant')), value: 'rephrase' },
          { label: ("Translate Text"|t('ai-assistant')), value: 'translate' },
          { label: ("Generate Image"|t('ai-assistant')), value: 'image' },
        ],
      }) }}
    </div>

    <div id="image-options" class="field aiassistant-hidden">
      <div class="flex">
        <div class="field">
          {{ forms.selectField({
            label: ("Asset Destination"|t('ai-assistant')),
            instructions: ("Select the volume or folder where generated images will be saved."|t('ai-assistant')),
            id: 'assetTarget',
            name: 'assetTarget',
            value: prompt.assetTarget ? prompt.assetTarget : (defaultAssetTargetValue ?? ''),
            options: assetTargetOptions ?? [{ label: '— None —', value: '' }],
            required: true,
          }) }}
        </div>
        <div class="field">
          {{ forms.textField({
            id: 'imageSize',
            name: 'imageSize',
            label: 'Image Size'|t('ai-assistant'),
            value: prompt.imageSize ?? '',
            placeholder: '1024x1024',
            instructions: ("Specify the image dimensions (width x height), for example `1024x1024`."|t('ai-assistant'))
          }) }}
        </div>
        <div class="field">
          {{ forms.textField({
            label: ("Count"|t('ai-assistant')),
            id: 'imageCount',
            name: 'imageCount',
            value: prompt.imageCount ?? 1,
            type: 'number',
            instructions: ("Number of images to generate, e.g. `1`. Some providers limit to `4`."|t('ai-assistant'))
          }) }}
        </div>
      </div>
      <p class="instructions">{{ ("These defaults are saved with the prompt and prefill the generation modal when this prompt is used."|t('ai-assistant')) }}</p>
    </div>

    <div class="field">
      {{ forms.textareaField({
        label: "Prompt Text"|t('ai-assistant'),
        instructions: "Enter the prompt text that will be sent to the AI. You can use variables and context placeholders."|t('ai-assistant'),
        id: 'promptText',
        name: 'promptText',
        value: prompt.promptText,
        rows: 6,
        required: true,
      }) }}
    </div>

    {# Removed AI Model override; integration default will be used #}

    {# Active and Sort Order fields - hidden for now, will be implemented later #}
    {#
    <div class="flex" style="gap:16px;">
      <div class="field" style="flex:1;">
        {{ forms.lightswitchField({
          label: "Active"|t('ai-assistant'),
          id: 'isActive',
          name: 'isActive',
          on: prompt.isActive,
        }) }}
      </div>
      <div class="field" style="flex:1;">
        {{ forms.textField({
          label: "Sort Order"|t('ai-assistant'),
          id: 'sortOrder',
          name: 'sortOrder',
          type: 'number',
          value: prompt.sortOrder ?? 0,
        }) }}
      </div>
    </div>
    #}
  </form>
{% endblock %}


