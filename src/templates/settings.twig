{% extends "_layouts/cp" %}

{% import "_includes/forms" as forms %}

{% set title = "AI Assistant Settings" %}
{% set selectedSubnavItem = 'settings' %}
{% set crumbs = [
  { label: 'AI Assistant', url: url('ai-assistant') },
  { label: 'Settings', url: url('ai-assistant/settings') },
] %}

{% block actionButton %}
    <button type="button" class="btn submit" onclick="document.getElementById('ai-assistant-settings-form').submit()">{{ "Save"|t('app') }}</button>
{% endblock %}

{% block content %}
<form method="post" accept-charset="UTF-8" id="ai-assistant-settings-form">
    {{ csrfInput() }}
    {{ actionInput('ai-assistant/settings/save') }}

    {# No custom license UI; Craft handles plugin licensing #}

    <div style="display:flex; justify-content:space-between; align-items:center; margin: 8px 0 16px;">
        <div>
            <h2 style="margin:0;">Enable per Field</h2>
            <p class="instructions" style="margin:4px 0 0;">Select which fields will show the AI Assistant button.</p>
        </div>
        <div style="display:flex; gap:8px;">
            <button type="button" id="enable-all" class="btn">{{ 'Enable all'|t('app') }}</button>
            <button type="button" id="disable-all" class="btn">{{ 'Disable all'|t('app') }}</button>
        </div>
    </div>

        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Field'|t('app') }}</th>
                    <th>{{ 'Handle'|t('app') }}</th>
                    <th>{{ 'Type'|t('app') }}</th>
                    <th>{{ 'Field Specific Prompt'|t('app') }}</th>
                    <th style="text-align:right;">{{ 'Enabled'|t('app') }}</th>
                </tr>
            </thead>
            <tbody>
            {% set enabledSet = (settings.enabledFieldHandles is defined and settings.enabledFieldHandles is iterable) ? settings.enabledFieldHandles : [] %}
            {% for f in allFields %}
                {% set checked = (enabledSet ? (enabledSet[f.handle] ?? (f.handle in enabledSet)) : false) %}
                <tr>
                    <td>{{ f.name }}</td>
                    <td><code>{{ f.handle }}</code></td>
                    <td><code>{{ f.type }}</code></td>
                    <td>
                        {% set selectedId = settings.fieldPrompts[f.handle] ?? '' %}
                        {% set selectedPrompt = (allPrompts|filter(p => p.id == selectedId)|first) %}
                        <div class="ai-prompts-chip">
                            {% if selectedPrompt %}
                                <span class="ai-assistant-type-badge ai-assistant-type-{{ selectedPrompt.type }}">{{ selectedPrompt.name }}</span>
                            {% else %}
                                <span class="ai-assistant-type-badge ai-assistant-type-any">{{ 'Any'|t('app') }}</span>
                            {% endif %}
                            <button type="button" class="btn small" title="{{ 'Edit'|t('app') }}" onclick="window.AiAssistant && window.AiAssistant.openPromptPicker && window.AiAssistant.openPromptPicker('{{ f.handle }}')">
                                <span data-icon="edit"></span>
                            </button>
                        </div>
                        <input type="hidden" name="settings[fieldPrompts][{{ f.handle }}]" value="{{ selectedId }}" data-prompt-value="{{ f.handle }}" />
                    </td>
                    <td style="width:120px; text-align:right;">
                        <div style="display:inline-block;">
                            {{ forms.lightswitchField({
                                id: 'enabled-' ~ f.handle,
                                name: 'settings[enabledFieldHandles][' ~ f.handle ~ ']',
                                on: checked,
                                small: true,
                                label: null,
                            }) }}
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

    <script>
        (function(){
          const form = document.getElementById('ai-assistant-settings-form');
          const enableAll = document.getElementById('enable-all');
          const disableAll = document.getElementById('disable-all');
          function setAll(on){
            if (!form) return;
            const hiddenInputs = form.querySelectorAll('input[type="hidden"][name^="settings[enabledFieldHandles]"]');
            hiddenInputs.forEach(function(hidden){
              // Try to find the adjacent lightswitch container
              let ls = hidden.nextElementSibling && hidden.nextElementSibling.classList.contains('lightswitch') ? hidden.nextElementSibling : null;
              if (!ls) {
                const td = hidden.closest('td');
                if (td) ls = td.querySelector('.lightswitch');
              }
              if (ls && window.jQuery && jQuery(ls).data('lightswitch')) {
                const api = jQuery(ls).data('lightswitch');
                if (on) api.turnOn(); else api.turnOff();
              } else if (ls) {
                // Fallback: update UI state and hidden input value
                ls.classList.toggle('on', !!on);
                ls.classList.toggle('off', !on);
                ls.setAttribute('aria-checked', on ? 'true' : 'false');
                hidden.value = on ? '1' : '';
              }
            });
          }
          if (enableAll) enableAll.addEventListener('click', function(){ setAll(true); });
          if (disableAll) disableAll.addEventListener('click', function(){ setAll(false); });

          // Light selectize-like UX for multi-selects (search + tags)
          document.querySelectorAll('[data-prompt-select]').forEach(function(select){
            try {
              if (window.$ && $.fn.selectize) {
                $(select).selectize({
                  plugins: ['remove_button'],
                  placeholder: '{{ "Select prompts"|t('app') }}',
                  dropdownParent: 'body',
                  allowEmptyOption: true,
                  closeAfterSelect: false,
                });
              }
            } catch(e) {}
          });
        })();
    </script>
</form>

<style>
.ai-prompts-cell{display:flex;gap:8px;align-items:center}
.ai-prompts-cell .ai-prompts-select{min-width:260px;}
.ai-prompts-cell .hint{color:var(--gray-600);font-size:12px}
.ai-prompts-chip{display:flex;gap:8px;align-items:center}

/* Match the prompts page badge styling */
.ai-assistant-type-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

.ai-assistant-type-generate { background:#e6f4ff; color:#1a73e8; }
.ai-assistant-type-rephrase { background:#f3e8ff; color:#7b1fa2; }
.ai-assistant-type-translate { background:#e6f7ee; color:#2e7d32; }
.ai-assistant-type-image { background:#fff4e5; color:#b26a00; }
.ai-assistant-type-any { background:#f3f4f6; color:#374151; }

/* Match the prompts page edit button styling */
.ai-prompts-chip .btn {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    min-width: 32px !important;
    height: 32px !important;
}

.ai-prompts-chip .btn span[data-icon] {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 16px !important;
    height: 16px !important;
    margin: 0 !important;
}

.ai-prompts-chip .btn span[data-icon] svg {
    width: 16px !important;
    height: 16px !important;
    display: block !important;
}
</style>
{% endblock %} 