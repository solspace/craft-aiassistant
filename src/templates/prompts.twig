{% extends "_layouts/cp" %}

{% import "_includes/forms" as forms %}

{% set title = "AI Assistant Prompts" %}
{% set selectedSubnavItem = 'prompts' %}

{% block actionButton %}
    <div class="btngroup">
        <a class="btn submit" href="{{ url('ai-assistant/prompts/edit') }}">
            <span data-icon="plus"></span>
            Add Prompt
        </a>
    </div>
{% endblock %}

{% block content %}
<div class="ai-assistant-prompts">

    <div class="ai-assistant-prompts-list">
        {% if prompts|length > 0 %}
            <table class="data fullwidth ai-prompts-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Integration</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for prompt in prompts %}
                        <tr class="{% if prompt.isBuiltIn %}ai-assistant-builtin-prompt{% endif %}">
                            <td>
                                <strong>{{ prompt.name }}{% if 'image' in prompt.name|lower %} (Coming Soon){% endif %}</strong>
                                {% if prompt.isBuiltIn %}
                                    <span class="ai-assistant-builtin-badge">Built-in</span>
                                {% endif %}
                                <div class="ai-assistant-prompt-text">{{ prompt.promptText|length > 80 ? prompt.promptText|slice(0, 80) ~ '…' : prompt.promptText }}</div>
                            </td>
                            <td>
                                <span class="ai-assistant-type-badge ai-assistant-type-{{ prompt.type }}">{{ prompt.type|title }}</span>
                            </td>
                            <td>
                                {% if prompt.isBuiltIn %}
                                    Any
                                {% else %}
                                    {{ prompt.integrationHandle ?: 'Default' }}
                                {% endif %}
                            </td>
                            <td>
                                <div class="ai-assistant-actions">
                                    <a class="btn small" href="{{ url('ai-assistant/prompts/edit', { id: prompt.id }) }}" title="Edit">
                                        <span data-icon="edit"></span>
                                    </a>
                                    {% if not prompt.isBuiltIn %}
                                        <form method="post" style="display:inline;">
                                            {{ csrfInput() }}
                                            {{ actionInput('ai-assistant/prompts/delete') }}
                                            {{ hiddenInput('id', prompt.id) }}
                                            <button type="submit" class="btn small delete" onclick="return confirm('Are you sure you want to delete this prompt?')" title="Delete">
                                                <span data-icon="trash"></span>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="ai-assistant-empty-state">
                <h3>No custom prompts yet</h3>
                <p>Create your first custom prompt to get started with AI Assistant.</p>
                <a class="btn submit" href="{{ url('ai-assistant/prompts/edit') }}">Add Your First Prompt</a>
            </div>
        {% endif %}
    </div>

    <!-- Coming Soon Section -->
    <div class="ai-assistant-coming-soon">
        <h3>Coming Soon</h3>
        
        <div class="ai-assistant-coming-soon-item">
            <div class="ai-assistant-coming-soon-content">
                <div class="ai-assistant-coming-soon-header">
                    <span class="ai-assistant-type-badge ai-assistant-type-image">Image</span>
                    <strong>Generate Images</strong>
                </div>
                <div class="ai-assistant-coming-soon-description">
                    Generate, edit, enhance, and create high-quality images from text descriptions using AI.
                </div>
            </div>
            <div class="ai-assistant-coming-soon-status">
                <span class="ai-assistant-status-badge">Coming Soon</span>
            </div>
        </div>
    </div>
</div>

<style>
.ai-assistant-prompts-header {
    margin-bottom: 24px;
}

.ai-assistant-prompts-header h2 {
    margin-bottom: 8px;
}

.ai-assistant-prompts-header p {
    color: #666;
    margin: 0;
}

.ai-assistant-prompts-info {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 6px;
    padding: 16px;
    margin-top: 16px;
}

.ai-assistant-prompts-info p {
    margin: 0 0 12px 0;
}

.ai-assistant-prompts-info ul {
    margin: 0;
    padding-left: 20px;
}

.ai-assistant-prompts-info li {
    margin-bottom: 6px;
    color: #555;
}

.ai-assistant-prompt-text {
    font-size: 12px;
    color: #666;
    margin-top: 4px;
}

.ai-assistant-type-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

.ai-assistant-type-generate { background:#e6f4ff; color:#1a73e8; }
.ai-assistant-type-rephrase { background:#f3e8ff; color:#7b1fa2; }
.ai-assistant-type-translate { background:#e6f7ee; color:#2e7d32; }
.ai-assistant-type-image { background:#fff4e5; color:#b26a00; }

.ai-assistant-builtin-prompt {
    background-color: #f8f9fa;
}

.ai-assistant-builtin-badge {
    display: inline-block;
    background: #e3f2fd;
    color: #1976d2;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 8px;
    margin-left: 8px;
    text-transform: uppercase;
}

.ai-assistant-actions {
    display: flex !important;
    flex-direction: row !important;
    gap: 8px;
    align-items: center;
}

.ai-assistant-actions form {
    display: inline-block !important;
    margin: 0;
}

.ai-assistant-actions .btn [data-icon] {
    margin-block-start: 0 !important;
    margin-inline-end: 0 !important;
    margin: 0 !important;
}

.ai-assistant-actions .btn {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    min-width: 32px !important;
    height: 32px !important;
}

.ai-assistant-actions .btn span[data-icon] {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 16px !important;
    height: 16px !important;
}

.ai-assistant-actions .btn span[data-icon] svg {
    width: 16px !important;
    height: 16px !important;
    display: block !important;
}

.ai-assistant-empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #f8f9fa;
    border-radius: 8px;
    border: 2px dashed #dee2e6;
}

.ai-assistant-empty-icon {
    font-size: 48px;
    margin-bottom: 16px;
}

.ai-assistant-empty-state h3 {
    margin-bottom: 8px;
    color: #495057;
}

.ai-assistant-empty-state p {
    color: #6c757d;
    margin-bottom: 24px;
}

.ai-assistant-coming-soon {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid #e9ecef;
}

.ai-assistant-coming-soon h3 {
    margin-bottom: 16px;
    color: #495057;
    font-size: 16px;
}

.ai-assistant-coming-soon-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    margin-bottom: 12px;
}

.ai-assistant-coming-soon-content {
    flex: 1;
}

.ai-assistant-coming-soon-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
}

.ai-assistant-coming-soon-description {
    font-size: 14px;
    color: #6c757d;
}

.ai-assistant-status-badge {
    display: inline-block;
    background: #fff3cd;
    color: #856404;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 12px;
    text-transform: uppercase;
    border: 1px solid #ffeaa7;
}
</style>
{% endblock %} 