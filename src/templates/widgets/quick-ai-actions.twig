{% import "_includes/forms" as forms %}

<div class="aiassistant-widget">
    <div class="aiassistant-widget-header">
        <p class="light">{{ "Generate content directly from the dashboard"|t('ai-assistant') }}</p>
    </div>

    <div class="aiassistant-widget-content">
        <form id="aiassistant-quick-form">
            <div class="field">
                {{ forms.selectField({
                    label: "Prompt"|t('ai-assistant'),
                    id: 'aiassistant-widget-prompt',
                    name: 'prompt',
                    options: [
                        {
                            label: "Custom text..."|t('ai-assistant'),
                            value: "custom-text",
                            data: {
                                type: 'text',
                                promptText: '',
                                imageSize: '',
                                imageCount: '',
                                assetTarget: '',
                                integration: ''
                            }
                        },
                        {
                            label: "Custom image..."|t('ai-assistant'),
                            value: "custom-image",
                            data: {
                                type: 'image',
                                promptText: '',
                                imageSize: '',
                                imageCount: '1',
                                assetTarget: defaultAssetTargetValue ?? '',
                                integration: ''
                            }
                        },
                    ]|merge(prompts|map(prompt => {
                        label: prompt.name,
                        value: prompt.id,
                        data: {
                            promptText: prompt.promptText|e('html_attr'),
                            type: prompt.type ?? 'generate',
                            imageSize: prompt.imageSize ?? '',
                            imageCount: prompt.imageCount ?? '',
                            assetTarget: prompt.assetTarget ?? '',
                            integration: prompt.integrationHandle ?? ''
                        }
                    })),
                    instructions: "Choose a prompt to generate content with"|t('ai-assistant')
                }) }}
            </div>

            <div id="aiassistant-widget-prompt-field" class="field">
                {{ forms.textareaField({
                    label: "Prompt Text"|t('ai-assistant'),
                    id: 'aiassistant-widget-prompt-text',
                    name: 'promptText',
                    rows: 4,
                    instructions: "Edit the prompt text as needed. This is what will be sent to the AI."|t('ai-assistant'),
                    placeholder: "Select a prompt above or write your own custom prompt..."
                }) }}
            </div>

            <div id="aiassistant-widget-image-options" class="field aiassistant-hidden">
                <div class="aiassistant-widget-image-options-row">
                    <div class="field">
                        {{ forms.textField({
                            label: "Image Size"|t('ai-assistant'),
                            id: 'aiassistant-widget-image-size',
                            name: 'imageSize',
                            placeholder: "1024x1024",
                            instructions: "Optional. Use WidthxHeight (for example, 1024x1024)."|t('ai-assistant')
                        }) }}
                    </div>
                    <div class="field count-field">
                        {{ forms.textField({
                            label: "Image Count"|t('ai-assistant'),
                            id: 'aiassistant-widget-image-count',
                            name: 'imageCount',
                            type: 'number',
                            min: 1,
                            value: 1,
                            instructions: "Number of images to request (many providers allow 1-4)."|t('ai-assistant')
                        }) }}
                    </div>
                </div>
                <div class="field asset-target-field">
                    {{ forms.selectField({
                        label: "Save To"|t('ai-assistant'),
                        id: 'aiassistant-widget-asset-target',
                        name: 'assetTarget',
                        options: assetTargetOptions ?? [{ label: '— None —', value: '' }],
                        value: defaultAssetTargetValue ?? '',
                        instructions: "Choose where generated images should be saved."|t('ai-assistant'),
                        inputAttributes: {
                            'data-default-value': defaultAssetTargetValue ?? ''
                        }
                    }) }}
                </div>
            </div>

            <div class="field">
                {{ forms.selectField({
                    label: "Integration"|t('ai-assistant'),
                    id: 'aiassistant-widget-integration',
                    name: 'integration',
                    options: integrations|map(integration => { 
                        label: integration.name, 
                        value: integration.handle,
                        data: {
                            type: integration.type ?? ''
                        }
                    }),
                    instructions: "Select the AI service to use"|t('ai-assistant')
                }) }}
            </div>

            <div id="aiassistant-widget-output-field" class="field">
                {{ forms.textareaField({
                    label: "Generated Content"|t('ai-assistant'),
                    id: 'aiassistant-widget-output',
                    name: 'output',
                    rows: 4,
                    readonly: true,
                    instructions: "AI-generated content will appear here"|t('ai-assistant')
                }) }}
            </div>

            <div id="aiassistant-widget-image-preview" class="aiassistant-widget-image-preview aiassistant-hidden">
                <button type="button" class="aiassistant-image-slider-button prev" aria-label="{{ 'Previous image'|t('ai-assistant') }}" disabled>&lt;</button>
                <div class="aiassistant-image-slider-stage">
                    <img class="aiassistant-image-slider-img" src="" alt="{{ 'Generated image preview'|t('ai-assistant') }}" />
                    <div class="aiassistant-image-slider-placeholder">{{ "Generate to preview images"|t('ai-assistant') }}</div>
                </div>
                <button type="button" class="aiassistant-image-slider-button next" aria-label="{{ 'Next image'|t('ai-assistant') }}" disabled>&gt;</button>
                <div class="aiassistant-image-slider-counter"></div>
            </div>

            <div class="aiassistant-widget-actions">
                <button type="button" id="aiassistant-widget-generate" class="btn submit">
                    {{ "Generate"|t('ai-assistant') }}
                </button>
                <button type="button" id="aiassistant-widget-copy" class="btn aiassistant-hidden" disabled>
                    {{ "Copy"|t('ai-assistant') }}
                </button>
                <button type="button" id="aiassistant-widget-save" class="btn aiassistant-hidden" disabled>
                    {{ "Save to Assets"|t('ai-assistant') }}
                </button>
                <div id="aiassistant-widget-loading" class="spinner aiassistant-hidden"></div>
            </div>
        </form>
    </div>
</div>
